  "mixins": [
    "odyssey.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-language-kotlin": ">=1.13.13+kotlin.2.4.10",
    "fabric-api": ">=0.141.6+1.21.11",
    "minecraft": "1.21.11",
    "java": ">=25"
  }
}
